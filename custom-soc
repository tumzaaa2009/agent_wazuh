EXCLUDED_RULE_IDS = {
    "550",
    "554",
    "594",
    "597",
    "598",
    "750",
    "751",
    "752",
    "92200",
}
# 120063 now visible for CSV Phase - was hidden before, CSV needs it as marker
CSV_VISIBLE_RULES = {"120063","120113","120110","120111","120112"}

_env_excluded = env.get("EXCLUDED_RULE_IDS", "")
if _env_excluded:
    EXCLUDED_RULE_IDS.update(
