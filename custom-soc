    )


# ============================================================================
# Malware Event
# ============================================================================

def report_malware_event(alert, full_log):

    sha256 = ""
    md5 = ""
    filepath = ""
    yara_rule = ""

    data = alert.get("data", {})

    if isinstance(data, dict):
        sha256 = data.get("sha256", "")
        md5 = data.get("md5", "")
        filepath = data.get("src", "")
        yara_rule = data.get("yara_match", "")

    if not sha256:
        try:
            pos = full_log.find("{")

            if pos != -1:
                js = json.loads(full_log[pos:])

                wy = js.get("wazuh_yara", {})

                sha256 = wy.get("sha256", "")
                md5 = wy.get("md5", "")
                filepath = wy.get("src", wy.get("file", ""))
                yara_rule = wy.get(
                    "yara_match",
                    wy.get("scan_result", "")
                )

        except Exception:
            pass

    syscheck = alert.get("syscheck", {})

    if isinstance(syscheck, dict):
        filepath = filepath or syscheck.get("path", "")
        sha256 = sha256 or syscheck.get("sha256_after", "")
        md5 = md5 or syscheck.get("md5_after", "")

    win = alert.get("win", {})
    eventdata = win.get("eventdata", {})

    if isinstance(eventdata, dict):

        filepath = filepath or eventdata.get("image", "")

        hashes = eventdata.get("hashes", "")

        if hashes:

            if not sha256:
                m = re.search(r"SHA256=([A-Fa-f0-9]+)", hashes)
                if m:
                    sha256 = m.group(1)

            if not md5:
                m = re.search(r"MD5=([A-Fa-f0-9]+)", hashes)
                if m:
                    md5 = m.group(1)

    filename = ""

    if filepath:
        filename = filepath.replace("\\", "/").split("/")[-1]

    payload = {

        "hospital_code": HOSPITAL_CODE,
        "hospital_name": HOSPITAL_NAME,

        "hash_sha256": sha256,
        "hash_md5": md5,

        "filename": filename,
        "filepath": filepath,

        "yara_rule_matched": yara_rule,

        "agent_id": alert.get("agent", {}).get("id", ""),
        "agent_name": alert.get("agent", {}).get("name", ""),

        "timestamp": alert.get("timestamp", "")
    }

    try:

        r = requests.post(
            MALWARE_API_URL,
            json=payload,
            headers=HEADERS,
            timeout=10,
            verify=False
        )

        if r.status_code != 200:
            error_msg = f"[malware-event] HTTP {r.status_code}"
            write_log(error_msg)

    except Exception as e:
        write_log(f"[malware-event] ERROR: {e}")



# ============================================================================
# Main
# ============================================================================

def main():

    if len(sys.argv) < 2:
        return

    alert_file = sys.argv[1]

    try:

        with open(alert_file, "r") as f:
            alert = json.load(f)

    except Exception as e:
        write_log(f"[custom-soc] Cannot read alert: {e}")
        return

    if "_source" in alert:
        alert = alert["_source"]

    rule = alert.get("rule", {})

    level = int(rule.get("level", 0))
    rule_id = str(rule.get("id", ""))
    description = rule.get("description", "")
    groups = rule.get("groups", [])

    if rule_id in EXCLUDED_RULE_IDS or "syscheck_registry" in groups:
        return

    full_log = alert.get("full_log", "")

    if (
        "QUARANTINED" in full_log
        or "yara" in description.lower()
        or "malware" in groups
        or "yara_quarantine" in groups
    ):
        report_malware_event(alert, full_log)

    # Phase4: Operational Diagnostics Noise Separation Router
    WINDOWS_ERROR_RULE_IDS = {"60600","60602","60100","60101","61110"}
    is_windows_error = rule_id in WINDOWS_ERROR_RULE_IDS or rule_id.startswith("6060") or "windows_system_error" in groups or "windows_error" in groups

    # Anti-bottleneck: drop noise early (whitelist/fp_filter never send)
    if "whitelist" in groups or "fp_filter" in groups:
        return

    # Check OWASP & Web Application Attacks (SQLi, XSS, Path Traversal, File Inclusion, etc.)
    WEB_OWASP_GROUPS = {"web", "web_scan", "web_appsec", "sql_injection", "xss", "rce", "attack"}
    is_web_owasp = (
        bool(set(groups) & WEB_OWASP_GROUPS)
        or rule_id.startswith("311")
        or rule_id.startswith("315")
        or "owasp" in description.lower()
        or "sql injection" in description.lower()
        or "xss" in description.lower()
        or "traversal" in description.lower()
    )

    # Chain-aware lv filter: >=7 = keep C2/ransomware/cred dump, drop noise. Always allow OWASP & Critical Web Attacks
    if level >= 7 or is_web_owasp:
        payload = alert.copy()
        payload["hospital_code"] = HOSPITAL_CODE
        payload["hospital_name"] = HOSPITAL_NAME

        # Extract Key Security Fields for Central SOC Dashboards & Triage
        data = alert.get("data", {})
        win = alert.get("win", {})
        eventdata = win.get("eventdata", {}) if isinstance(win, dict) else {}

        # 1. Source & Destination IP
        src_ip = alert.get("srcip") or (data.get("srcip") if isinstance(data, dict) else None) or eventdata.get("sourceIp")
        dest_ip = alert.get("dstip") or (data.get("dstip") if isinstance(data, dict) else None) or eventdata.get("destinationIp")
        if src_ip:
            payload["src_ip"] = src_ip
        if dest_ip:
            payload["dest_ip"] = dest_ip

        # 2. MITRE ATT&CK Context
        mitre = rule.get("mitre", {})
        if mitre:
            payload["mitre"] = mitre

        # 3. File & Process IoC Context
        filepath = None
        if alert.get("syscheck", {}).get("path"):
            filepath = alert["syscheck"]["path"]
        elif eventdata.get("targetFilename"):
            filepath = eventdata["targetFilename"]
        elif eventdata.get("image"):
            filepath = eventdata["image"]

        if filepath:
            payload["file_path"] = filepath
            payload["file_name"] = filepath.replace("\\", "/").split("/")[-1]

        # 4. OWASP Classification Flag
        if is_web_owasp:
            payload["attack_type"] = "OWASP_Web_Attack"

        # Routing: Default to API_URL (fallback if windows-errors endpoint gives 404)
        target_url = API_URL
        tag = "custom-soc"

        try:
            r = requests.post(
                target_url,
                json=payload,
                headers=HEADERS,
                timeout=10,
                verify=False
            )
            if r.status_code in (200, 201):
                write_log(f"[{tag}] rule={rule_id} level={level} -> HTTP {r.status_code} OK ({'OWASP' if is_web_owasp else 'security'})")
            else:
                write_log(f"[{tag}] rule={rule_id} level={level} -> HTTP {r.status_code}")

        except Exception as e:
            write_log(f"[{tag}] ERROR rule={rule_id}: {e}")




if __name__ == "__main__":
    main()