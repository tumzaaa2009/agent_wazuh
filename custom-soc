ENV_FILE = "/var/hos-edge-connector/.env"


def write_log(message):
    log_path = "/var/ossec/logs/integrations.log"
    try:
        if os.path.exists(log_path) and os.path.getsize(log_path) > 10 * 1024 * 1024:
            os.rename(log_path, f"{log_path}.1")
    except Exception:
        pass
    try:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with open(log_path, "a") as log:
            log.write(f"[{now}] {message}\n")
    except Exception:
        pass




def load_env(path):
    env = {}

    try:
        with open(path, "r") as f:
            for line in f:

                line = line.strip()

                if not line or line.startswith("#"):
                    continue

                if "=" not in line:
                    continue

                key, value = line.split("=", 1)

                key = key.strip()
                value = value.split("#")[0].strip()

                if value.startswith('"') and value.endswith('"'):
                    value = value[1:-1]

                elif value.startswith("'") and value.endswith("'"):
                    value = value[1:-1]

                env[key] = value

    except Exception as e:
        write_log(f"[custom-soc] ERROR reading .env : {e}")

    return env


env = load_env(ENV_FILE)

API_BASE = env.get(
    "API_URL",
    "https://rh4cloudcenter.moph.go.th/api/v1"
).rstrip("/")

API_URL = f"{API_BASE}/alerts"
MALWARE_API_URL = f"{API_BASE}/malware-events"
WINDOWS_ERROR_API_URL = f"{API_BASE}/windows-errors"

API_KEY = env.get("API_KEY", "")
HOSPITAL_CODE = env.get("HOSPITAL_CODE", "")
HOSPITAL_NAME = env.get("HOSPITAL_NAME", "")

DEVICE_ID_FILE = "/var/hos-edge-connector/.device_id"
def get_hardware_id():
    try:
        with open(DEVICE_ID_FILE, "r") as f:
            return f.read().strip()
    except Exception:
        return "unknown"

HEADERS = {
    "Authorization": f"Bearer {API_KEY}",
    "Content-Type": "application/json",
    "User-Agent": "Mozilla/5.0",
    "x-hardware-id": get_hardware_id()
}

if not API_KEY:
    write_log("[custom-soc] ERROR: API_KEY missing from .env")


# ============================================================================
# Excluded Rule IDs (rule id ที่ไม่ต้องการส่งขึ้น API)
# เพิ่ม rule id ใหม่ในลิสต์นี้ได้เลย เช่น "550", "551", "5501"
