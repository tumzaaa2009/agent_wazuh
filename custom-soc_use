#!/var/ossec/framework/python/bin/python3
import sys
import json
import re
import requests
import urllib3

# Suppress SSL warnings (self-signed cert environment)
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

API_URL = "https://rh4cloudcenter.moph.go.th/api/v1/alerts"
MALWARE_API_URL = "https://rh4cloudcenter.moph.go.th/api/v1/malware-events"
API_KEY = "KEY_141"
HOSPITAL_CODE = "141"

HEADERS = {
    "Authorization": f"Bearer {API_KEY}",
    "Content-Type": "application/json",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
}

def report_malware_event(alert: dict, full_log: str):
    """Parse QUARANTINED log and report malware hash event to central SOC."""
    sha256_match = re.search(r'sha256=([a-fA-F0-9]+)', full_log)
    md5_match    = re.search(r'md5=([a-fA-F0-9]+)', full_log)
    src_match    = re.search(r'src=([^\s]+)', full_log)
    yara_match   = re.search(r'yara_match=(.+?)(?:\s+sha256=|$)', full_log)

    filepath  = src_match.group(1).strip('"') if src_match else ""
    filename  = filepath.split("/")[-1].split("\\")[-1] if filepath else ""

    malware_payload = {
        "hospital_code": HOSPITAL_CODE,
        "hash_sha256": sha256_match.group(1) if sha256_match else "",
        "hash_md5":    md5_match.group(1)    if md5_match    else "",
        "filename":    filename,
        "filepath":    filepath,
        "yara_rule_matched": yara_match.group(1).strip() if yara_match else alert.get("rule", {}).get("description", ""),
        "agent_id":    alert.get("agent", {}).get("id",   ""),
        "agent_name":  alert.get("agent", {}).get("name", ""),
        "action_taken": "DELETED",
        "timestamp":   alert.get("timestamp", "")
    }

    try:
        r2 = requests.post(
            MALWARE_API_URL,
            json=malware_payload,
            headers=HEADERS,
            timeout=10,
            verify=False
        )
        with open("/var/ossec/logs/integrations.log", "a") as log:
            log.write(f"[malware-event] Reported {filepath} sha256={malware_payload['hash_sha256']} -> {r2.status_code}\n")
    except Exception as e:
        with open("/var/ossec/logs/integrations.log", "a") as log:
            log.write(f"[malware-event-fail] {filepath}: {e}\n")

def main():
    with open("/var/ossec/logs/integrations.log", "a") as log:
        log.write(f"custom-soc triggered with args: {sys.argv}\n")

    if len(sys.argv) < 2:
        return

    alert_file = sys.argv[1]
    try:
        with open(alert_file, "r") as f:
            alert = json.load(f)
    except Exception as e:
        with open("/var/ossec/logs/integrations.log", "a") as log:
            log.write(f"Error loading JSON: {e}\n")
        return

    if "_source" in alert:
        alert = alert["_source"]

    rule_level = alert.get("rule", {}).get("level", 0)
    rule_desc  = alert.get("rule", {}).get("description", "")
    full_log   = alert.get("full_log", "")

    # --- YARA Malware Event Hook ---
    # Detect QUARANTINED events (from yara.sh / yara.bat active response)
    if "QUARANTINED" in full_log or "yara" in rule_desc.lower():
        with open("/var/ossec/logs/integrations.log", "a") as log:
            log.write(f"[malware-event] YARA/QUARANTINED event detected. Reporting to SOC...\n")
        report_malware_event(alert, full_log)

    # --- Standard Alert Forwarding (Level > 5) ---
    if int(rule_level) > 5:
        payload = alert.copy()
        payload["hospital_code"] = HOSPITAL_CODE
        try:
            r = requests.post(
                API_URL,
                json=payload,
                headers=HEADERS,
                timeout=10,
                verify=False
            )

            with open("/var/ossec/logs/integrations.log", "a") as log:
                log.write(f"Sent alert. Response: {r.status_code}\n")
        except Exception as e:
            with open("/var/ossec/logs/integrations.log", "a") as log:
                log.write(f"Error sending custom-soc alert: {e}\n")

if __name__ == "__main__":
    main()